# Public build metadata. These values are safe to expose in the client bundle.
VITE_APP_ENV=production

# Public Supabase browser configuration. Use only the publishable key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional future authenticated sync API. Leave empty for the local-first MVP.
# The endpoint must authenticate with secure same-origin cookies; never place a
# private API key in a VITE_ variable because Vite exposes those to the browser.
VITE_SYNC_ENDPOINT=

# Server-only examples for a future Vercel Function. Do not prefix secrets with VITE_.
DATABASE_URL=
SYNC_ENCRYPTION_KEY=
